{
  "name": "@mbd/sim-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playtest": "MBD_PLAYTEST_DUMP=1 vitest run tests/playtestNarrativeDump.generate.ts",
    "playtest:sample": "PLAYTEST_SEED=2601 PLAYTEST_YEARS=10 PLAYTEST_OUT=playtest-output/sample-dynasty.md MBD_PLAYTEST_DUMP=1 vitest run tests/playtestNarrativeDump.generate.ts",
    "build": "tsc -b"
  },
  "dependencies": {
    "@mbd/contracts": "workspace:*",
    "pure-rand": "^7.0.0"
  },
  "devDependencies": {
    "fast-check": "^4.6.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
